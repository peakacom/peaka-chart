# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# AI coding agent config. Not just noise: some harnesses materialise these as
# character-special /dev/null mounts, and Helm's loader aborts the whole chart
# on any irregular file ("cannot load irregular file ... file mode type bits
# set"). The .helmignore check runs before that test, so excluding them here
# keeps `helm template`/`package` working when an agent runs in the repo.
.claude/
.mcp.json
# Temporary values file
.values.yaml
